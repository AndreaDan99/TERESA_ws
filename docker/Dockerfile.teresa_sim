# =============================================================================
# teresa_sim — Simulation-only image for SpotZi visualization (RViz)
#
# Base: humble-desktop-pytorch = ROS2 Humble Desktop + PyTorch 2.0 CUDA + RViz
#   Already includes: rviz2, joint_state_publisher_gui, xacro, robot_state_publisher,
#   rclpy, cv_bridge, tf2_*, visualization_msgs, PyTorch 2.0, torchvision, CUDA 11.4
#
# Workspace is mounted at runtime via:
#   -v /home/spot_orin/AndreaDantonaTeresa/TERESA_ws:/ros2_ws
#
# BUILD (on Jetson Orin):
#   docker build -f docker/Dockerfile.teresa_sim -t teresa_sim:latest .
#
# RUN:
#   docker run -d --name teresa_sim --runtime=nvidia --net=host \
#     -e DISPLAY=:1 -v /tmp/.X11-unix:/tmp/.X11-unix \
#     -v /home/spot_orin/AndreaDantonaTeresa/TERESA_ws:/ros2_ws \
#     -v /ssd/andrea_deploy:/work \
#     teresa_sim:latest sleep infinity
# =============================================================================

FROM dustynv/ros:humble-desktop-pytorch-l4t-r35.4.1

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV HF_HOME=/work/hf_cache

# ── System dependencies (native libs + build tools + hardware drivers) ──────
# Drop stale ROS apt sources to avoid GPG key errors during apt-get update
RUN rm -f /etc/apt/sources.list.d/*ros* 2>/dev/null; \
    apt-get update && apt-get install -y --no-install-recommends \
    \
    # === BUILD TOOLS ===
    build-essential cmake git wget curl \
    python3-pip python3-colcon-common-extensions \
    python3-rosdep python3-vcstool \
    \
    # === TORCH NATIVE LIBS (same as teresa_gpu) ===
    libopenblas0 libjpeg-turbo8 libpng16-16 \
    \
    # === INTEL REALSENSE D435 (librealsense2) ===
    librealsense2-dev libeigen3-dev \
    \
    # === ORBBEC FEMTO BOLT ===
    libgflags-dev nlohmann-json3-dev libgoogle-glog-dev \
    libssl-dev libdw-dev mesa-utils libgl1 libopencv-dev \
    \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Python perception dependencies ─────────────────────────────────────────
# Same validated versions as teresa_gpu / andrea_deploy.
# DO NOT pip-install torch/torchvision — base image has Jetson GPU build.
RUN pip3 install "typing-extensions>=4.5" sympy networkx jinja2 filelock mpmath pillow && \
    pip3 install transformers==4.44.2 safetensors scipy matplotlib && \
    pip3 install --no-deps ultralytics ultralytics-thop && \
    pip3 install psutil py-cpuinfo pandas tqdm requests pyyaml && \
    pip3 install pinocchio transforms3d

# ── Shell environment ──────────────────────────────────────────────────────
RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc && \
    echo 'source /ros2_ws/install/setup.bash 2>/dev/null' >> /root/.bashrc && \
    echo 'export ROS_DOMAIN_ID=0' >> /root/.bashrc && \
    echo 'export RCUTILS_COLORIZED_OUTPUT=1' >> /root/.bashrc

# ── Labels ─────────────────────────────────────────────────────────────────
LABEL maintainer="andrea.dantona@unife.it"
LABEL description="teresa_sim — SpotZi simulation & visualization (RViz + GUI)"
LABEL version="l4t-r35.4.1-desktop"
LABEL ros_distro="humble"
LABEL cuda_version="11.4"

WORKDIR /work
CMD ["bash"]
