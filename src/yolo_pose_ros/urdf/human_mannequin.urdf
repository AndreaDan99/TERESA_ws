<?xml version="1.0"?>
<robot name="human_mannequin">

  <!-- ===================== -->
  <!--        MATERIALS      -->
  <!-- ===================== -->
  <material name="skin">
    <color rgba="0.9 0.7 0.6 1.0"/>
  </material>

  <material name="bone">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>

  <!-- ===================== -->
  <!--        ROOT           -->
  <!-- ===================== -->
  <link name="pelvis"/>

  <!-- ===================== -->
  <!--        TORSO          -->
  <!-- ===================== -->
  <link name="torso">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.12"/>
      </geometry>
      <material name="skin"/>
    </visual>
  </link>

  <joint name="pelvis_to_torso" type="fixed">
    <parent link="pelvis"/>
    <child link="torso"/>
    <origin xyz="0 0 0.25"/>
  </joint>

  <!-- ===================== -->
  <!--        HEAD           -->
  <!-- ===================== -->
  <link name="head">
    <visual>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
      <material name="skin"/>
    </visual>
  </link>

  <joint name="neck" type="revolute">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="5" velocity="5"/>
  </joint>

  <!-- ===================== -->
  <!--      LEFT ARM         -->
  <!-- ===================== -->
  <link name="upper_arm_l">
    <visual>
      <geometry>
        <cylinder length="0.30" radius="0.05"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="shoulder_l" type="revolute">
    <parent link="torso"/>
    <child link="upper_arm_l"/>
    <origin xyz="0 0.18 0.45"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="10"/>
  </joint>

  <link name="lower_arm_l">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.04"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="elbow_l" type="revolute">
    <parent link="upper_arm_l"/>
    <child link="lower_arm_l"/>
    <origin xyz="0 0 0.30"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.7" effort="10" velocity="10"/>
  </joint>

  <!-- ===================== -->
  <!--      RIGHT ARM        -->
  <!-- ===================== -->
  <link name="upper_arm_r">
    <visual>
      <geometry>
        <cylinder length="0.30" radius="0.05"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="shoulder_r" type="revolute">
    <parent link="torso"/>
    <child link="upper_arm_r"/>
    <origin xyz="0 -0.18 0.45"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="10"/>
  </joint>

  <link name="lower_arm_r">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.04"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="elbow_r" type="revolute">
    <parent link="upper_arm_r"/>
    <child link="lower_arm_r"/>
    <origin xyz="0 0 0.30"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.7" effort="10" velocity="10"/>
  </joint>

  <!-- ===================== -->
  <!--      LEFT LEG         -->
  <!-- ===================== -->
  <link name="upper_leg_l">
    <visual>
      <geometry>
        <cylinder length="0.45" radius="0.06"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="hip_l" type="revolute">
    <parent link="pelvis"/>
    <child link="upper_leg_l"/>
    <origin xyz="0 0.10 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="15" velocity="10"/>
  </joint>

  <link name="lower_leg_l">
    <visual>
      <geometry>
        <cylinder length="0.45" radius="0.05"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="knee_l" type="revolute">
    <parent link="upper_leg_l"/>
    <child link="lower_leg_l"/>
    <origin xyz="0 0 0.45"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="2.7" effort="15" velocity="10"/>
  </joint>

  <!-- ===================== -->
  <!--      RIGHT LEG        -->
  <!-- ===================== -->
  <link name="upper_leg_r">
    <visual>
      <geometry>
        <cylinder length="0.45" radius="0.06"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="hip_r" type="revolute">
    <parent link="pelvis"/>
    <child link="upper_leg_r"/>
    <origin xyz="0 -0.10 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="15" velocity="10"/>
  </joint>

  <link name="lower_leg_r">
    <visual>
      <geometry>
        <cylinder length="0.45" radius="0.05"/>
      </geometry>
      <material name="bone"/>
    </visual>
  </link>

  <joint name="knee_r" type="revolute">
    <parent link="upper_leg_r"/>
    <child link="lower_leg_r"/>
    <origin xyz="0 0 0.45"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="2.7" effort="15" velocity="10"/>
  </joint>

</robot>
