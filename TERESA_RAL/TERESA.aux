\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mission \ac {FSM} with 13 states. The robot searches for the patient through body rotation and dual-sensor confirmation (SEARCHING~$\to $~SEMI\_LOCKING~$\to $~LOCKING), approaches while running the anticipatory scanner (PRE\_APPROACH~$\to $~APPROACHING), performs a posture-adaptive exposure body scan with integrated wound and burn detection (EXPOSURE\_SCANNING), enters an interactive review phase for operator-driven re-inspection (EXPOSURE\_REVIEW), and executes \ac {FAST} ultrasound scanning with pre-planned body reconfiguration (SCANNING). Transitions are triggered by perception confidence (dashed) or geometric conditions (solid).}}{6}{figure.2}\protected@file@percent }
\acronymused{FSM}
\acronymused{FAST}
\newlabel{fig:fsm}{{2}{6}{Mission \ac {FSM} with 13 states. The robot searches for the patient through body rotation and dual-sensor confirmation (SEARCHING~$\to $~SEMI\_LOCKING~$\to $~LOCKING), approaches while running the anticipatory scanner (PRE\_APPROACH~$\to $~APPROACHING), performs a posture-adaptive exposure body scan with integrated wound and burn detection (EXPOSURE\_SCANNING), enters an interactive review phase for operator-driven re-inspection (EXPOSURE\_REVIEW), and executes \ac {FAST} ultrasound scanning with pre-planned body reconfiguration (SCANNING). Transitions are triggered by perception confidence (dashed) or geometric conditions (solid)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces System block diagram. The Perception layer processes dual-sensor \ac {RGBD} streams via \ac {YOLO}-pose, Kalman filtering, \ac {NLF} skeleton detection, surface estimation, and injury detection. The 13-state Mission \ac {FSM} orchestrates four Planning modules: Exposure Scanner, \ac {FAST} Ultrasound, Body Pose Optimizer, and the Web UI for interactive review. The Control layer executes real-time decisions through the \ac {WBC} \ac {QP}, \ac {IK} Goal Multiplexer, and Impedance Controller. Dashed arrows denote operator-triggered or posture-optimisation paths.}}{6}{figure.3}\protected@file@percent }
\acronymused{RGBD}
\acronymused{YOLO}
\acronymused{NLF}
\acronymused{FSM}
\acronymused{FAST}
\acronymused{WBC}
\acronymused{QP}
\acronymused{IK}
\newlabel{fig:system_block}{{3}{6}{System block diagram. The Perception layer processes dual-sensor \ac {RGBD} streams via \ac {YOLO}-pose, Kalman filtering, \ac {NLF} skeleton detection, surface estimation, and injury detection. The 13-state Mission \ac {FSM} orchestrates four Planning modules: Exposure Scanner, \ac {FAST} Ultrasound, Body Pose Optimizer, and the Web UI for interactive review. The Control layer executes real-time decisions through the \ac {WBC} \ac {QP}, \ac {IK} Goal Multiplexer, and Impedance Controller. Dashed arrows denote operator-triggered or posture-optimisation paths}{figure.3}{}}
